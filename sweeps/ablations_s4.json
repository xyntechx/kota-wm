{
 "name": "abl2100-s4",
 "defaults": {
  "until": 2100,
  "model_type": "gpt-mini",
  "agent_hidden_dim": 1024,
  "wm_hidden_dim": 1024,
  "seed": 4,
  "eval_episodes": 0,
  "checkpoint_every": 100,
  "config": {
   "context_steps": 64,
   "world_batch_size": 64,
   "imagined_rollouts": 64,
   "autocast": true,
   "outcome_features": "action",
   "imagination_horizon": 16
  },
  "snapshot_every": 100,
  "snapshot_eval_episodes": 200,
  "vocab": "shared"
 },
 "runs": [
  {
   "name": "compact-base",
   "obs_mode": "compact",
   "gpu": "L40S"
  },
  {
   "name": "compact-vocab",
   "obs_mode": "compact",
   "vocab": "mode",
   "gpu": "L40S"
  },
  {
   "name": "compact-pi-last",
   "obs_mode": "compact",
   "config": {
    "policy_features": "last"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-pi-mean",
   "obs_mode": "compact",
   "config": {
    "policy_features": "mean"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-wm-actobs",
   "obs_mode": "compact",
   "config": {
    "outcome_features": "action+obs"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-pi-obs",
   "obs_mode": "compact",
   "config": {
    "policy_features": "obs"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-pi-seq",
   "obs_mode": "compact",
   "config": {
    "policy_features": "seq"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-baseline-exact",
   "obs_mode": "compact",
   "gpu": "L40S",
   "config": {
    "context_steps": 64,
    "warmup_steps": 1024,
    "pretrain_updates": 100,
    "real_steps": 32,
    "world_updates": 30,
    "world_batch_size": 64,
    "imagined_rollouts": 64,
    "imagination_horizon": 16,
    "policy_epochs": 4,
    "policy_batch_size": 64,
    "epsilon": 0.3,
    "random_action_fraction": 0.1,
    "max_episode_steps": 256,
    "replay_capacity": 10000,
    "world_lr": 0.0003,
    "world_weight_decay": 0.1,
    "world_warmup_updates": 100,
    "world_dropout": 0.1,
    "autocast": false,
    "policy_lr": 0.0001,
    "reward_scale": 20.0,
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "temperature": 1.0,
    "grid_temperature": 0.5,
    "sample_termination": false,
    "imagine_from_real_context": true,
    "policy_features": "both",
    "clip_eps": 0.2,
    "value_coef": 0.5,
    "value_clip": 0.2,
    "entropy_coef": 0.02
   }
  },
  {
   "name": "compact-pi-current",
   "obs_mode": "compact",
   "config": {
    "policy_features": "current"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-wm-actobs-sg",
   "obs_mode": "compact",
   "config": {
    "outcome_features": "action+obs-sg"
   },
   "gpu": "L40S"
  },
  {
   "name": "compact-vocab-wm-actobs",
   "obs_mode": "compact",
   "vocab": "mode",
   "config": {
    "outcome_features": "action+obs"
   },
   "gpu": "L40S"
  }
 ]
}